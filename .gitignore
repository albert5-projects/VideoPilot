# Publish only the source distribution. New root files stay local until reviewed.
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/CHATTERBOX_NANO.md
!/FLOW_SETUP.html
!/START_HERE.txt
!/UPDATE_FROM_0.2.txt
!/Setup.bat
!/Launch.bat
!/Launch.vbs
!/Download_Models.bat
!/Install_Chatterbox_Nano.bat
!/Setup_Flow_Browser.bat
!/Inspect_Flow.bat
!/Run_Tests.bat

# Only reviewed source/documentation types inside distribution directories.
!/videopilot/
/videopilot/**
!/videopilot/**/
!/videopilot/**/*.py
!/videopilot/**/*.js
!/videopilot/**/*.cjs
!/videopilot/**/*.jsx
!/flow_extension/
/flow_extension/**
!/flow_extension/**/
!/flow_extension/**/*.js
!/flow_extension/manifest.json
!/docs/
/docs/**
!/docs/SOURCES.md
!/docs/VERIFICATION.md
!/tests/
/tests/**
!/tests/**/
!/tests/**/*.py
!/tests/**/*.cjs
!/tests/fixtures/flow-star-on-outline.png

# Always private/generated, even if created inside a source directory.
**/__pycache__/
**/node_modules/
**/.venv*/
**/.git/
**/.codex/
**/.agents/
**/.aws/
**/.ssh/
**/.env
**/.env.*
**/*credentials*
**/*secrets*
**/*token*.json
**/auth.json
**/storage_state*.json
**/cookies*
**/browser-profile*/
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/*.tmp
**/*.partial*
**/*.sqlite*
**/*.db
**/.pytest_cache/
**/.coverage*
**/htmlcov/
**/*.egg-info/
**/build/
**/dist/
